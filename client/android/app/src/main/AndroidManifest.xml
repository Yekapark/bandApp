<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 저장소 권한은 쓰지 않는다 — 사진·영상은 시스템 선택기(image_picker)가 앱 캐시로 복사해 주고, 압축본도 앱 캐시에
         쓴다. 영상 압축 플러그인(v_video_compressor)이 제 매니페스트에 넣어 오는 것을 병합 단계에서 뺀다(LAUNCH_REVIEW P10).
         쓰지 않는 권한은 심사에서 "왜 필요한가" 를 부르고 데이터 보안 답안과도 어긋나 보인다. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- 위치 권한(ACCESS_FINE/COARSE_LOCATION)은 2026-09-09 에 지웠다. 지도를 쓰지만 기기 위치는
         한 번도 읽지 않는다 — 위치 플러그인 의존성이 없고, 지도의 hasLocation 은 합주실 좌표다.
         쓰지 않는 권한은 스토어 심사에서 용도를 묻고 데이터 안전 신고와도 어긋나 보인다.
         "내 위치" 기능을 넣을 때 함께 되살린다. (docs/legal/play-app-content.md §0-2) -->

    <!-- Auto Backup 을 끈다. flutter_secure_storage 는 토큰을 SharedPreferences 에 암호화해 넣고
         복호화 키는 Android KeyStore 에 두는데, KeyStore 는 백업 대상이 아니다. 백업이 켜져 있으면
         재설치 시 "열쇠 없는 금고"만 복원돼서 토큰을 읽을 수 없다. 복원해도 못 쓰는 데이터다. -->
    <application
        android:allowBackup="false"
        android:label="밴듈"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 초대 링크. 랜딩 페이지(https://.../invite/{code})가 bandule://invite/{code} 로
                 앱을 부른다. 이 필터가 없으면 링크를 눌러도 앱이 열리지 않는다.

                 스킴이 `bandapp` 이 아니라 `bandule` 인 이유 - `bandapp://` 는 네이버 밴드가
                 쓰는 주소다. 예전 값으로 두면 초대 링크가 네이버 밴드 앱을 연다(실제로 그랬다).

                 브라우저 주소창에서 앱이 바로 열리는 App Links 는 릴리스 서명 키의 지문을
                 assetlinks.json 에 올려야 해서 스토어 등록 뒤에 붙인다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bandule" android:host="invite" />
            </intent-filter>
        </activity>
        <!-- 카카오 로그인: 브라우저(커스텀 탭)가 인가 코드를 kakao{네이티브앱키}://oauth 로 돌려준다.
             이 intent-filter 가 없으면 카카오계정 로그인이 브라우저에서 멈추고 앱으로 못 돌아온다.
             액티비티 자체는 kakao_flutter_sdk_common 이 선언하고, 여기서는 스킴만 얹는다.
             SDK 2.x 에서 클래스 이름이 바뀌었다(AuthCodeCustomTabsActivity → auth.AuthCodeHandlerActivity).
             옛 이름이 남으면 빌드는 되는데 로그인 뒤 앱으로 못 돌아온다.
             kakaoAppKey 는 client/dart_defines.json 의 KAKAO_NATIVE_APP_KEY 에서 온다(build.gradle.kts).
             다트 쪽 KakaoSdk.init 과 같은 파일을 본다 — 한쪽만 바뀌어 어긋나는 일이 없게. -->
        <activity
            android:name="com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao${kakaoAppKey}" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- 앱이 꺼져 있을 때 온 푸시가 뜰 채널. 이게 없으면 안드로이드가 FCM 기본 채널을
             쓰고, 휴대폰 설정의 앱 알림 목록에 "기타" 로 나온다.
             채널 자체는 MainActivity 에서 만든다 — id 가 같아야 한다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bandule_default" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- url_launcher 로 https 링크(Play 구독 관리 화면)를 열 때. Android 11+ 패키지 가시성. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
