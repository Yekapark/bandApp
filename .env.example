# docker compose 용 변수. 복사해서 .env 로 사용한다: cp .env.example .env
DB_NAME=bandapp
DB_USERNAME=bandapp
DB_PASSWORD=bandapp

# JWT 서명 키 — 32자 이상. 운영에서는 반드시 새로 생성한다.
#   생성 예: openssl rand -base64 48
JWT_SECRET=local-compose-secret-change-me-at-least-32-characters

# 카카오 개발자 콘솔 > 내 애플리케이션 값.
# 비워 두면 카카오 로그인만 503으로 응답하고 이메일 로그인 등 나머지는 정상 동작한다.
# ADMIN_KEY 는 카카오 API 무제한 호출이 가능한 마스터 키다. 절대 클라이언트/저장소에 노출 금지.
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=
