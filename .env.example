# docker compose 용 변수. 복사해서 .env 로 사용한다:  cp .env.example .env
# 아래 값 중 최소 JWT_SECRET 은 반드시 채워야 앱이 뜬다(빈 값이면 부팅 실패 — 의도).

# --- DB ---
DB_NAME=bandapp
DB_USERNAME=bandapp
# 로컬 전용 값. 운영에서는 반드시 강한 값으로 바꾼다.
DB_PASSWORD=CHANGE_ME_local_only

# --- JWT 서명 키 ---
# 32자 이상. 비워 두면 앱이 기동에 실패한다(알려진 키로 서명하는 사고를 막기 위해 기본값 없음).
#   생성:  openssl rand -base64 48
JWT_SECRET=

# --- 카카오 (선택) ---
# 카카오 개발자 콘솔 > 내 애플리케이션 값. 비워 두면 카카오 로그인만 503으로 응답하고
# 이메일 로그인 등 나머지는 정상 동작한다.
# ADMIN_KEY 는 카카오 API 무제한 호출이 가능한 마스터 키다. 절대 클라이언트/저장소에 노출 금지.
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=

# --- 네이버 지도 지오코딩 (선택) ---
# 네이버 클라우드 플랫폼 콘솔 > Maps > Application 의 인증 정보. 비워 두면 합주실 등록 시
# 주소만 저장되고 좌표(lat/lng)는 null 이 된다 — 등록 자체는 정상 동작한다.
# 나중에 값을 채우고 앱을 재기동하면 그때부터 좌표가 붙는다.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# --- Cloudflare R2 (미디어 업로드, 선택) ---
# Cloudflare 대시보드 > R2 > 버킷 + API 토큰(S3 호환). 비워 두면 게시판 첨부 업로드/조회 API 만
# 503(MEDIA_STORAGE_NOT_CONFIGURED)으로 응답하고, 게시글·신고·차단은 정상 동작한다.
# 파일은 클라이언트가 presigned URL 로 R2 에 직접 올린다 — 백엔드를 경유하지 않는다.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Firebase Cloud Messaging (푸시 알림, 선택) ---
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 에서 비공개 키(JSON)를 받는다. 비워 두면 푸시 발송만
# 건너뛰고(no-op) 디바이스 토큰 등록·알림 설정 API 는 정상 동작한다. 나중에 값을 채우고 재기동하면
# 그때부터 실제로 발송된다. FCM_CREDENTIALS_PATH(파일 경로) 또는 FCM_CREDENTIALS_JSON(JSON 문자열)
# 중 하나만 채우면 된다. 둘 다 있으면 JSON 문자열이 우선한다.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_JSON=
