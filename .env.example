# docker compose 용 변수. 복사해서 .env 로 사용한다:  cp .env.example .env
# 아래 값 중 최소 JWT_SECRET 은 반드시 채워야 앱이 뜬다(빈 값이면 부팅 실패 — 의도).

# --- DB ---
DB_NAME=bandapp
DB_USERNAME=bandapp
# 로컬 전용 값. 운영에서는 반드시 강한 값으로 바꾼다.
DB_PASSWORD=CHANGE_ME_local_only

# --- JWT 서명 키 ---
# 32자 이상. 비워 두면 앱이 기동에 실패한다(알려진 키로 서명하는 사고를 막기 위해 기본값 없음).
#   생성:  openssl rand -base64 48
JWT_SECRET=

# --- 카카오 (선택) ---
# 카카오 개발자 콘솔 > 내 애플리케이션 값. 비워 두면 카카오 로그인만 503으로 응답하고
# 이메일 로그인 등 나머지는 정상 동작한다.
# ADMIN_KEY 는 카카오 API 무제한 호출이 가능한 마스터 키다. 절대 클라이언트/저장소에 노출 금지.
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=

# --- 네이버 지도 지오코딩 (선택) ---
# 네이버 클라우드 플랫폼 콘솔 > Maps > Application 의 인증 정보. 비워 두면 합주실 등록 시
# 주소만 저장되고 좌표(lat/lng)는 null 이 된다 — 등록 자체는 정상 동작한다.
# 나중에 값을 채우고 앱을 재기동하면 그때부터 좌표가 붙는다.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
