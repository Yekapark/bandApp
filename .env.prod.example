# 운영 VM 의 /opt/bandapp/.env.prod 로 복사해 채운다. 이 파일은 절대 커밋하지 않는다.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# 로컬 개발용 .env 와 별개다(로컬은 .env.example → .env).

# --- 도메인 / TLS ---
# 2026-09-06 에 bandule.com 을 등록했다. API 는 서브도메인을 쓴다.
#   api.bandule.com  → 이 백엔드
#   bandule.com      → 약관·개인정보처리방침·초대 랜딩(정적, Cloudflare Pages)
DOMAIN=api.bandule.com
LETSENCRYPT_EMAIL=                          # 인증서 만료 경고 수신 주소 (본인 메일)

# --- 배포 이미지 ---
# deploy/deploy.sh 가 배포할 때마다 IMAGE_TAG 를 갈아 끼운다. 롤백은 이 값을 이전 sha-xxxx 로
# 되돌리고 docker compose ... up -d 하면 된다.
APP_IMAGE=ghcr.io/yekapark/bandapp
IMAGE_TAG=latest

# --- DB (호스트에 포트를 열지 않는다. 컨테이너 네트워크 전용) ---
DB_NAME=bandapp
DB_USERNAME=bandapp
DB_PASSWORD=                                # openssl rand -base64 32

# --- Redis (리프레시 토큰·차단목록이 들어 있다. 비워 두지 않는다) ---
REDIS_PASSWORD=                             # openssl rand -base64 32

# --- JWT ---
JWT_SECRET=                                 # openssl rand -base64 48 (32자 이상, 없으면 부팅 실패)

# --- CORS ---
# Flutter 웹을 붙이면 그 오리진을 적는다. '*' 는 쓰지 않는다.
CORS_ALLOWED_ORIGINS=https://bandule.com

# --- 카카오 ---
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=
KAKAO_REST_API_KEY=

# --- Cloudflare R2 (미디어 + DB 백업 업로드에 함께 쓴다) ---
R2_ACCOUNT_ID=
R2_BUCKET=                                  # 운영용 버킷. 개발용(bandapp-media-dev)을 그대로 쓰지 않는다
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=                              # 비우면 https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# --- FCM ---
FCM_PROJECT_ID=
FCM_CREDENTIALS_HOST_PATH=./secrets/fcm.json          # VM 의 실제 파일 경로 (chmod 600)
FCM_CREDENTIALS_PATH=/run/secrets/fcm-credentials.json

# --- 딥링크 / 스토어 ---
DEEPLINK_SCHEME=bandapp
IOS_APP_ID=
IOS_APP_STORE_URL=
ANDROID_PACKAGE=com.yeka.bandule
ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.yeka.bandule
ANDROID_SHA256_CERT_FINGERPRINTS=

# --- 백업 ---
BACKUP_KEEP=7                               # 로컬·R2 각각 최근 N 개 보관
